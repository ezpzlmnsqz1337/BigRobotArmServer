[Unit]
Description=BigRobotArm WebSocket bridge
After=network.target

[Service]
Type=simple
User=__BIGROBOTARM_USER__
WorkingDirectory=__BIGROBOTARM_SERVER_DIR__
Environment=PATH=/home/__BIGROBOTARM_USER__/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/__BIGROBOTARM_USER__/.local/bin/uv run python websocket_server.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target